{
	"name": "abp3-sistema-gestao-leads",
	"version": "0.1.0",
	"private": true,
	"description": "Single repository do Sistema de Gestao de Leads com Dashboard Analitico da ErrorSquad-ABP",
	"workspaces": [
		"front",
		"back"
	],
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0"
	},
	"scripts": {
		"start:docker:remote": "node scripts/docker-dev.mjs",
		"start:docker:local": "node scripts/docker-dev.mjs --local",
		"start:native:remote": "node scripts/run-native.mjs",
		"start:native:local": "node scripts/run-native.mjs --local",
		"stop:docker:remote": "node scripts/docker-down.mjs",
		"stop:docker:local": "node scripts/docker-down.mjs --local --volumes",
		"db:up": "docker compose -f docker-compose.postgres.yml up -d",
		"db:down": "docker compose -f docker-compose.postgres.yml down",
		"clean:dev": "node scripts/clean-dev-cache.mjs",
		"dev": "npm run start:docker:remote",
		"dev:local": "npm run start:docker:local",
		"dev:down": "npm run stop:docker:remote",
		"db:generate": "npm run prisma:generate -w back",
		"db:migrate": "npm run prisma:migrate:deploy -w back",
		"db:migrate:local": "DATABASE_URL=postgresql://abp:abp@127.0.0.1:5433/lead_management npm run prisma:migrate:deploy -w back",
		"db:migrate:dev": "npm run prisma:migrate:dev -w back",
		"db:seed": "npm run prisma:seed -w back",
		"db:seed:local": "DATABASE_URL=postgresql://abp:abp@127.0.0.1:5433/lead_management npm run prisma:seed -w back",
		"guard:root-package": "node scripts/check-root-package.mjs",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint --write .",
		"lint:check": "biome lint .",
		"check": "biome check --write .",
		"check:ci": "biome ci .",
		"lint:eslint": "eslint front/src back/src back/prisma --ext .ts,.tsx --max-warnings 0",
		"lint:eslint:blocking": "npm run lint:eslint",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"quality:gate:blocking": "npm run guard:root-package && npm run format:check && npm run lint:check && npm run typecheck && npm run lint:eslint && npm run build",
		"quality:gate:advisory": "npm run guard:root-package && npm run format:check && npm run lint:check && npm run lint:eslint",
		"build": "npm run build --workspaces --if-present",
		"security:check": "node scripts/security-check.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@eslint/js": "9.39.4",
		"@typescript-eslint/eslint-plugin": "8.57.1",
		"@typescript-eslint/parser": "8.57.1",
		"eslint": "9.39.4",
		"eslint-plugin-no-unsanitized": "4.1.5",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-security": "4.0.0",
		"typescript": "5.9.3"
	},
	"overrides": {
		"@nestjs/common": "11.1.18",
		"@nestjs/core": "11.1.18",
		"@nestjs/platform-express": "11.1.18",
		"@prisma/dev": {
			"@hono/node-server": "1.19.13",
			"hono": "4.12.14"
		},
		"@modelcontextprotocol/sdk": {
			"@hono/node-server": "1.19.13",
			"hono": "4.12.14"
		},
		"defu": "6.1.6",
		"lodash": "4.18.1",
		"minimatch@10.2.4": {
			"brace-expansion": "5.0.5"
		},
		"minimatch@3.1.5": {
			"brace-expansion": "1.1.13"
		},
		"picomatch": "4.0.4"
	}
}
