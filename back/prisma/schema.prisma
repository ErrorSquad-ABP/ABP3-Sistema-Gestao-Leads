generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ATTENDANT
  MANAGER
  GENERAL_MANAGER
  ADMIN
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  PHONE
  WALK_IN
  INDICATION
  OTHER
  INSTAGRAM
  FACEBOOK
  MERCADO_LIVRE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATING
  CONVERTED
  LOST
}

enum DealImportance {
  COLD
  WARM
  HOT
}

enum DealStage {
  INITIAL_CONTACT
  NEGOTIATION
  PROPOSAL
  CLOSING
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum DealLossReason {
  NO_INTEREST
  PRICE_EXPECTATION
  BOUGHT_ELSEWHERE
  NO_RESPONSE
  VEHICLE_UNAVAILABLE
  OTHER
}

enum DealHistoryField {
  IMPORTANCE
  STAGE
  STATUS
  TITLE
  VALUE
  VEHICLE
  LOSS_REASON
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
}

enum LeadEventType {
  CREATED
  UPDATED
  REASSIGNED
  CONVERTED
}

enum SupportedFuelType {
  GASOLINE
  ETHANOL
  FLEX
  DIESEL
  ELECTRIC
  HYBRID
  PLUG_IN_HYBRID
  CNG
}

enum AgendaItemType {
  TASK
  EVENT
}

enum AgendaItemStatus {
  SCHEDULED
  DONE
  CANCELLED
}

enum AgendaRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model AccessGroup {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  description   String
  baseRole      UserRole?
  featureKeys   Json
  isSystemGroup Boolean   @default(false)
  users         User[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  email         String       @unique
  password      String
  role          UserRole
  accessGroupId String?      @db.Uuid
  accessGroup   AccessGroup? @relation(fields: [accessGroupId], references: [id], onDelete: SetNull)

  memberTeams  Team[] @relation("TeamMembers")
  managedTeams Team[] @relation("TeamManager")

  ownedLeads   Lead[]        @relation("LeadOwner")
  leadEvents   LeadEvent[]   @relation("LeadEventActor")
  auditLogs    AuditLog[]
  authSessions AuthSession[]
  agendaItems  AgendaItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@map("auth_sessions")
}

model Team {
  id   String @id @default(uuid()) @db.Uuid
  name String

  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  members   User[]  @relation("TeamMembers")
  managerId String? @db.Uuid
  manager   User?   @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  addressLine        String?
  city               String?
  state              String?   @db.VarChar(2)
  region             String?
  distributionRegion String?
  coverage           String?
  scope              String?
  teams              Team[]
  leads              Lead[]
  vehicles           Vehicle[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?  @unique
  phone     String?
  cpf       String?  @unique @db.VarChar(11)
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id                  String      @id @default(uuid()) @db.Uuid
  customerId          String      @db.Uuid
  storeId             String      @db.Uuid
  ownerUserId         String?     @db.Uuid
  source              LeadSource
  status              LeadStatus  @default(NEW)
  vehicleInterestText String?
  customer            Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store               Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  owner               User?       @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deals               Deal[]
  events              LeadEvent[]
  agendaItems         AgendaItem[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([createdAt])
  @@index([storeId, createdAt])
}

model LeadEvent {
  id          String        @id @default(uuid()) @db.Uuid
  leadId      String        @db.Uuid
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorUserId String?       @db.Uuid
  actorUser   User?         @relation("LeadEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  type        LeadEventType
  title       String
  description String
  payload     Json?
  createdAt   DateTime      @default(now())

  @@index([leadId, createdAt])
  @@index([actorUserId])
}

model Vehicle {
  id                    String            @id @default(uuid()) @db.Uuid
  storeId               String            @db.Uuid
  brand                 String
  model                 String
  version               String?
  modelYear             Int
  manufactureYear       Int?
  color                 String?
  mileage               Int
  supportedFuelType     SupportedFuelType
  price                 Decimal           @db.Decimal(12, 2)
  status                VehicleStatus
  plate                 String?
  vin                   String?
  imageUrl              String?
  imageAlt              String?
  imageProvider         String?
  imageProviderPhotoId  String?
  imagePhotographerName String?
  imagePhotographerUrl  String?
  imageSourceUrl        String?
  imageResolvedAt       DateTime?
  imageExpiresAt        DateTime?
  store                 Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  deals                 Deal[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([storeId])
  @@index([status, createdAt])
}

model Deal {
  id         String         @id @default(uuid()) @db.Uuid
  leadId     String         @db.Uuid
  vehicleId  String         @db.Uuid
  title      String
  value      Decimal?       @db.Decimal(12, 2)
  importance DealImportance
  stage      DealStage
  status     DealStatus
  lossReason DealLossReason?
  closedAt   DateTime?
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  history    DealHistory[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([leadId])
  @@index([vehicleId])
}

model DealHistory {
  id          String           @id @default(uuid()) @db.Uuid
  dealId      String           @db.Uuid
  deal        Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  field       DealHistoryField
  fromValue   String?
  toValue     String
  actorUserId String?          @db.Uuid
  createdAt   DateTime         @default(now())

  @@index([dealId, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityName  String
  entityId    String?
  metadata    Json?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model AgendaItem {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  leadId      String?          @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead        Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  type        AgendaItemType
  status      AgendaItemStatus @default(SCHEDULED)
  recurrence  AgendaRecurrence @default(NONE)
  title       String
  description String?
  location    String?
  startsAt    DateTime?
  endsAt      DateTime?
  dueAt       DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([leadId])
  @@index([userId, leadId])
  @@index([userId, status, startsAt])
  @@index([userId, status, dueAt])
  @@index([userId, startsAt])
  @@index([userId, dueAt])
  @@index([userId, status])
  @@map("agenda_items")
}
